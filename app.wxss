/* 合一 Skills - 全局样式 */
/* 禅意极简 × 宣纸松墨 × 朱砂点睛 */

page {
  background-color: #f5f1e8;
  color: #1a1713;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Noto Serif SC", "Songti SC", serif;
  line-height: 1.6;
}

/* 颜色变量 */
.page {
  background: #f5f1e8;
  min-height: 100vh;
}

/* 宣纸纹理背景 */
.page-bg {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background:
    radial-gradient(ellipse at 15% 10%, rgba(156, 58, 42, 0.03), transparent 50%),
    radial-gradient(ellipse at 85% 85%, rgba(26, 23, 19, 0.04), transparent 55%);
  pointer-events: none;
  z-index: 0;
}

/* 留白规范 */
.container {
  padding: 24rpx 32rpx 32rpx;
  position: relative;
  z-index: 1;
}

/* 文字颜色 */
.text-ink { color: #1a1713; }
.text-ink-soft { color: #3d362c; }
.text-ink-mist { color: #857b6a; }
.text-ink-faint { color: #c9bfa8; }
.text-cinnabar { color: #9c3a2a; }

/* 背景色 */
.bg-paper { background-color: #f5f1e8; }
.bg-paper-2 { background-color: #ede7d8; }
.bg-ink { background-color: #1a1713; }
.bg-cinnabar { background-color: #9c3a2a; }

/* 边框 */
.border-line { border-color: rgba(26, 23, 19, 0.08); }
.border-line-strong { border-color: rgba(26, 23, 19, 0.16); }

/* 朱砂印章效果 */
.seal {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 16rpx;
  background: #9c3a2a;
  color: #f5f1e8;
  font-size: 20rpx;
  letter-spacing: 0.1em;
  border-radius: 4rpx;
}

/* 六门字符 */
.gate-char {
  font-size: 48rpx;
  font-weight: 400;
  color: #1a1713;
  letter-spacing: 0.1em;
}

/* 卡片样式 */
.card {
  background: #f5f1e8;
  border: 1rpx solid rgba(26, 23, 19, 0.08);
  border-radius: 8rpx;
  padding: 32rpx 24rpx;
}

.card:hover {
  background: #ede7d8;
}

/* 按钮样式 */
.btn-primary {
  background: #9c3a2a;
  color: #f5f1e8;
  border: none;
  padding: 24rpx 48rpx;
  border-radius: 4rpx;
  font-size: 28rpx;
  letter-spacing: 0.15em;
}

.btn-outline {
  background: transparent;
  color: #3d362c;
  border: 1rpx solid rgba(26, 23, 19, 0.16);
  padding: 24rpx 48rpx;
  border-radius: 4rpx;
  font-size: 28rpx;
  letter-spacing: 0.15em;
}

/* Chip 标签 */
.chip {
  display: inline-block;
  padding: 8rpx 20rpx;
  background: #ede7d8;
  border: 1rpx solid rgba(26, 23, 19, 0.16);
  border-radius: 100rpx;
  font-size: 22rpx;
  color: #3d362c;
  letter-spacing: 0.05em;
}

.chip.active {
  background: #1a1713;
  color: #f5f1e8;
  border-color: #1a1713;
}

/* 分割线 */
.divider {
  height: 1rpx;
  background: rgba(26, 23, 19, 0.08);
  margin: 32rpx 0;
}

.divider-strong {
  height: 1rpx;
  background: rgba(26, 23, 19, 0.16);
  margin: 32rpx 0;
}

/* 动效 */
@keyframes rise {
  from {
    opacity: 0;
    transform: translateY(16rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.animate-rise {
  animation: rise 0.6s cubic-bezier(0.2, 0.8, 0.2, 1) both;
}

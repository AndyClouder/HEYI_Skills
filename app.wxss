/* 合一 Skills · 全局样式 v2
   三色：宣纸 #f5f1e8 / 松墨 #1a1713 / 朱砂 #9c3a2a
   三体：Noto Serif SC（骨）· Cormorant Garamond Italic（气）· 系统字（身）
   三律：留白过半 · 线条克制 · 朱砂克制
*/

page {
  background-color: #f5f1e8;
  color: #1a1713;
  font-family: "Noto Serif SC", "Songti SC", -apple-system, BlinkMacSystemFont, "PingFang SC", serif;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}

/* 页面容器 */
.page {
  background: #f5f1e8;
  min-height: 100vh;
  position: relative;
}

/* 宣纸纹理 —— 极轻 */
.page-bg {
  position: fixed;
  inset: 0;
  background:
    radial-gradient(ellipse at 12% 8%, rgba(156, 58, 42, 0.035), transparent 55%),
    radial-gradient(ellipse at 88% 88%, rgba(26, 23, 19, 0.04), transparent 60%);
  pointer-events: none;
  z-index: 0;
}

.container {
  padding: 40rpx 40rpx 200rpx;
  position: relative;
  z-index: 1;
}

/* ========== 文字 ========== */
.t-ink { color: #1a1713; }
.t-soft { color: #3d362c; }
.t-mist { color: #857b6a; }
.t-faint { color: #c9bfa8; }
.t-cinnabar { color: #9c3a2a; }

.f-serif { font-family: "Noto Serif SC", "Songti SC", serif; }
.f-mono  { font-family: "JetBrains Mono", "SF Mono", Menlo, monospace; }
.f-italic {
  font-family: "Cormorant Garamond", "Noto Serif SC", serif;
  font-style: italic;
  font-weight: 300;
}

/* ========== 分割线 ========== */
.hair {
  height: 1rpx;
  background: rgba(26, 23, 19, 0.1);
  width: 100%;
}
.hair-strong {
  height: 1rpx;
  background: rgba(26, 23, 19, 0.18);
  width: 100%;
}

/* ========== 朱砂印章 ========== */
.seal {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  background: #9c3a2a;
  color: #f5f1e8;
  font-size: 22rpx;
  font-family: "Noto Serif SC", serif;
  letter-spacing: 0;
  border-radius: 2rpx;
}

/* ========== 六门门牌 ========== */
.gate-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 36rpx;
  height: 36rpx;
  background: #ede7d8;
  border: 1rpx solid rgba(26, 23, 19, 0.18);
  font-size: 22rpx;
  color: #3d362c;
}

/* ========== 按钮 ========== */
.btn-primary {
  background: #1a1713;
  color: #f5f1e8;
  border: none;
  padding: 28rpx 64rpx;
  font-size: 28rpx;
  letter-spacing: 0.3em;
  text-align: center;
  border-radius: 2rpx;
}

.btn-outline {
  background: transparent;
  color: #1a1713;
  border: 1rpx solid rgba(26, 23, 19, 0.3);
  padding: 28rpx 64rpx;
  font-size: 26rpx;
  letter-spacing: 0.2em;
  text-align: center;
  border-radius: 2rpx;
}

.btn-primary:active { opacity: 0.78; }
.btn-outline:active { background: #ede7d8; }

/* ========== 动效 ========== */
@keyframes rise {
  from { opacity: 0; transform: translateY(14rpx); }
  to   { opacity: 1; transform: translateY(0); }
}
.animate-rise {
  animation: rise 0.7s cubic-bezier(0.2, 0.8, 0.2, 1) both;
}
@keyframes fade {
  from { opacity: 0; }
  to   { opacity: 1; }
}
.animate-fade { animation: fade 0.6s both; }

/* ========== 工具 ========== */
.hide { display: none !important; }
.row { display: flex; flex-direction: row; }
.col { display: flex; flex-direction: column; }
.between { justify-content: space-between; }
.center { align-items: center; justify-content: center; }

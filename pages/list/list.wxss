/* 合一 Skills - 列表页样式 */

/* 六门筛选条 */
.gates-filter {
  white-space: nowrap;
  padding: 24rpx 0;
}

.filter-chips {
  display: inline-flex;
  gap: 12rpx;
  padding: 0 4rpx;
}

.filter-chips .chip {
  flex-shrink: 0;
  padding: 12rpx 24rpx;
  background: #f5f1e8;
  border: 1rpx solid rgba(26, 23, 19, 0.08);
  border-radius: 100rpx;
  font-size: 24rpx;
  color: #3d362c;
  letter-spacing: 0.05em;
  transition: all 0.3s;
}

.filter-chips .chip.active {
  background: #1a1713;
  color: #f5f1e8;
  border-color: #1a1713;
}

.filter-chips .chip .count {
  font-size: 20rpx;
  opacity: 0.65;
  margin-left: 4rpx;
}

/* 搜索行 */
.search-row {
  margin: 16rpx 0 24rpx;
}

.search-input-wrapper {
  position: relative;
  display: flex;
  align-items: center;
  background: #ede7d8;
  border-radius: 8rpx;
  padding: 0 24rpx;
}

.search-input {
  flex: 1;
  height: 72rpx;
  font-size: 28rpx;
  color: #1a1713;
}

.search-input::placeholder {
  color: #857b6a;
}

.search-clear {
  position: absolute;
  right: 24rpx;
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: #857b6a;
  line-height: 1;
}

/* 分类标题 */
.gate-header {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 32rpx 0 24rpx;
  border-bottom: 1rpx solid rgba(26, 23, 19, 0.16);
  margin-bottom: 24rpx;
}

.gate-big {
  font-size: 96rpx;
  font-weight: 400;
  color: #1a1713;
  line-height: 1;
}

.gate-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.gate-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #1a1713;
  letter-spacing: 0.1em;
}

.gate-desc {
  font-size: 22rpx;
  color: #857b6a;
}

/* 搜索结果提示 */
.search-result {
  padding: 16rpx 0;
  font-size: 24rpx;
  color: #3d362c;
}

.search-result .highlight {
  color: #9c3a2a;
  font-weight: 500;
}

/* 空状态 */
.empty-state {
  padding: 120rpx 0;
  text-align: center;
}

.empty-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
  opacity: 0.6;
}

.empty-text {
  display: block;
  font-size: 28rpx;
  color: #1a1713;
  margin-bottom: 8rpx;
}

.empty-hint {
  display: block;
  font-size: 24rpx;
  color: #857b6a;
}

/* 技能网格 */
.skills-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 16rpx;
  padding-bottom: 32rpx;
}

/* 技能卡片 */
.skill-card {
  background: #f5f1e8;
  border: 1rpx solid rgba(26, 23, 19, 0.08);
  border-radius: 8rpx;
  padding: 24rpx;
  transition: all 0.3s;
}

.skill-card:active {
  background: #ede7d8;
}

.card-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.skill-num {
  font-size: 40rpx;
  font-family: serif;
  font-style: italic;
  color: #c9bfa8;
  font-weight: 300;
  line-height: 1;
}

.skill-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.gate-badge {
  width: 36rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ede7d8;
  border: 1rpx solid rgba(26, 23, 19, 0.16);
  border-radius: 4rpx;
  font-size: 20rpx;
  color: #3d362c;
  font-weight: 500;
}

.skill-code {
  font-size: 20rpx;
  color: #857b6a;
  font-family: monospace;
  letter-spacing: 0.05em;
}

.card-body {
  margin-bottom: 16rpx;
}

.skill-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #1a1713;
  line-height: 1.4;
  margin-bottom: 8rpx;
}

.skill-desc {
  font-size: 24rpx;
  color: #3d362c;
  line-height: 1.7;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.card-foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(26, 23, 19, 0.08);
}

.skill-source {
  font-size: 22rpx;
  color: #857b6a;
  font-style: italic;
}

.skill-source {
  color: #9c3a2a;
}

.skill-rating {
  font-size: 20rpx;
  color: #c9bfa8;
}

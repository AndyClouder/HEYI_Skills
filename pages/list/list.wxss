/* ======== 列表页 ======== */

/* 大门牌 */
.gate-banner {
  padding: 48rpx 0 40rpx;
  margin-bottom: 32rpx;
  border-bottom: 1rpx solid rgba(26,23,19,0.18);
  position: relative;
}
.gb-num {
  font-size: 24rpx;
  color: #9c3a2a;
  letter-spacing: 0.35em;
  text-transform: uppercase;
  margin-bottom: 8rpx;
}
.gb-big {
  font-size: 160rpx;
  font-weight: 500;
  color: #1a1713;
  line-height: 1;
  letter-spacing: 0.05em;
  margin-bottom: 16rpx;
}
.gb-en {
  font-size: 28rpx;
  color: #857b6a;
  letter-spacing: 0.2em;
  margin-bottom: 12rpx;
}
.gb-desc {
  font-size: 24rpx;
  color: #3d362c;
  letter-spacing: 0.04em;
  margin-bottom: 20rpx;
}
.gb-count {
  font-size: 18rpx;
  color: #c9bfa8;
  letter-spacing: 0.2em;
}

/* 筛选 chip */
.filter-scroll {
  margin: 0 -40rpx 48rpx;
  padding: 0 40rpx;
  white-space: nowrap;
}
.filter-row {
  display: inline-flex;
  gap: 16rpx;
  padding: 4rpx 0;
}
.f-chip {
  flex-shrink: 0;
  padding: 14rpx 28rpx;
  border: 1rpx solid rgba(26,23,19,0.18);
  font-size: 24rpx;
  color: #3d362c;
  letter-spacing: 0.08em;
  background: transparent;
}
.f-chip.on {
  background: #1a1713;
  border-color: #1a1713;
  color: #f5f1e8;
}
.f-chip.on .f-chip-n { color: rgba(245,241,232,0.6); }
.f-chip-n {
  font-size: 20rpx;
  color: #c9bfa8;
  margin-left: 4rpx;
}

/* 列表 */
.skill-list {
  border-top: 1rpx solid rgba(26,23,19,0.1);
}
.sk {
  padding: 36rpx 4rpx;
  border-bottom: 1rpx solid rgba(26,23,19,0.1);
}
.sk:active { background: rgba(237,231,216,0.5); }

.sk-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
}
.sk-no {
  font-size: 40rpx;
  color: #c9bfa8;
  line-height: 1;
}
.sk-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.sk-code {
  font-size: 18rpx;
  color: #857b6a;
  letter-spacing: 0.12em;
}

.sk-name {
  font-size: 32rpx;
  color: #1a1713;
  letter-spacing: 0.04em;
  line-height: 1.5;
  margin-bottom: 12rpx;
}
.sk-desc {
  font-size: 24rpx;
  color: #857b6a;
  line-height: 1.75;
  margin-bottom: 20rpx;
}
.sk-foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(26,23,19,0.08);
}
.sk-rating {
  font-size: 20rpx;
  letter-spacing: 0.1em;
}
.sk-install {
  font-size: 18rpx;
  color: #c9bfa8;
  letter-spacing: 0.1em;
}

/* 空 */
.empty {
  padding: 160rpx 0;
  text-align: center;
}
.empty-ico {
  font-size: 120rpx;
  color: #c9bfa8;
  line-height: 1;
  margin-bottom: 32rpx;
}
.empty-t {
  font-size: 26rpx;
  color: #857b6a;
  letter-spacing: 0.2em;
}

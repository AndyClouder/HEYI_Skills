<!-- 技能列表 · 按门 -->
<view class="page">
  <view class="page-bg"></view>

  <view class="container">

    <!-- 门牌大字 -->
    <view class="gate-banner" wx:if="{{currentGate}}">
      <view class="gb-num f-italic">{{gateInfo.roman}}</view>
      <view class="gb-big">{{currentGate}}</view>
      <view class="gb-en f-italic">{{gateInfo.en}}</view>
      <view class="gb-desc">{{gateInfo.desc}}</view>
      <view class="gb-count f-mono">{{filteredSkills.length}} skills</view>
    </view>

    <!-- 六门筛选 -->
    <scroll-view class="filter-scroll" scroll-x show-scrollbar="{{false}}">
      <view class="filter-row">
        <view class="f-chip {{!currentGate ? 'on' : ''}}" bindtap="onGateFilter" data-gate="">
          全 · <text class="f-chip-n f-mono">{{total}}</text>
        </view>
        <view class="f-chip {{currentGate === item.id ? 'on' : ''}}"
              wx:for="{{gates}}" wx:key="id"
              bindtap="onGateFilter" data-gate="{{item.id}}">
          {{item.id}} · <text class="f-chip-n f-mono">{{item.count}}</text>
        </view>
      </view>
    </scroll-view>

    <!-- 空状态 -->
    <view class="empty" wx:if="{{filteredSkills.length === 0 && !loading}}">
      <view class="empty-ico f-italic">∅</view>
      <view class="empty-t">未见此门之技</view>
    </view>

    <!-- 技能列表 -->
    <view class="skill-list">
      <view class="sk" wx:for="{{filteredSkills}}" wx:key="code"
            bindtap="onSkillTap" data-code="{{item.code}}">
        <view class="sk-head">
          <view class="sk-no f-italic">{{item.no}}</view>
          <view class="sk-meta">
            <view class="gate-chip">{{item.gate}}</view>
            <text class="sk-code f-mono">{{item.code}}</text>
          </view>
        </view>
        <view class="sk-name">{{item.name}}</view>
        <view class="sk-desc">{{item.desc}}</view>
        <view class="sk-foot">
          <view class="sk-rating t-cinnabar">
            <text wx:for="{{item.rating}}" wx:for-item="s" wx:key="*">★</text>
          </view>
          <view class="sk-install f-mono" wx:if="{{item.installs}}">{{item.installs}} 装</view>
        </view>
      </view>
    </view>

  </view>
</view>

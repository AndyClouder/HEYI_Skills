.onb-head {
  padding: 40rpx 40rpx 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  position: relative;
  z-index: 2;
}
.onb-dots {
  display: flex;
  gap: 16rpx;
}
.dot {
  width: 32rpx;
  height: 4rpx;
  background: #c9bfa8;
  transition: background 0.4s;
}
.dot.on { background: #1a1713; }
.onb-skip {
  font-size: 24rpx;
  color: #857b6a;
  letter-spacing: 0.15em;
  padding: 12rpx 16rpx;
}

.onb-body {
  padding: 80rpx 48rpx 40rpx;
  animation: rise 0.7s cubic-bezier(.2,.8,.2,1) both;
}

.onb-eyebrow {
  font-family: "Cormorant Garamond", serif;
  font-style: italic;
  font-size: 22rpx;
  color: #9c3a2a;
  letter-spacing: 0.4em;
  text-transform: uppercase;
  margin-bottom: 24rpx;
}
.onb-title {
  font-size: 88rpx;
  font-weight: 500;
  letter-spacing: 0.3em;
  color: #1a1713;
  line-height: 1;
  margin-bottom: 24rpx;
}
.onb-sub {
  font-family: "Cormorant Garamond", "Noto Serif SC", serif;
  font-style: italic;
  font-size: 24rpx;
  color: #857b6a;
  letter-spacing: 0.1em;
  margin-bottom: 56rpx;
}

.onb-text {
  font-size: 28rpx;
  color: #3d362c;
  line-height: 1.9;
  margin-bottom: 64rpx;
}
.onb-text .break { height: 16rpx; }

/* 六门网格 */
.gates-six {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1rpx;
  background: rgba(26,23,19,0.1);
  border: 1rpx solid rgba(26,23,19,0.1);
}
.gx {
  background: #f5f1e8;
  padding: 36rpx 28rpx;
}
.gx-char {
  font-size: 52rpx;
  color: #1a1713;
  font-weight: 500;
  margin-bottom: 8rpx;
}
.gx-en {
  font-size: 22rpx;
  color: #9c3a2a;
  letter-spacing: 0.15em;
  margin-bottom: 12rpx;
}
.gx-desc {
  font-size: 22rpx;
  color: #857b6a;
  line-height: 1.7;
}

/* 三律 */
.rule-list {
  border-top: 1rpx solid rgba(26,23,19,0.18);
  border-bottom: 1rpx solid rgba(26,23,19,0.18);
}
.rule {
  padding: 40rpx 8rpx;
  display: flex;
  gap: 32rpx;
  align-items: flex-start;
}
.rule-num {
  font-size: 44rpx;
  color: #c9bfa8;
  line-height: 1;
  flex-shrink: 0;
  width: 100rpx;
}
.rule-body { flex: 1; }
.rule-t {
  font-size: 32rpx;
  color: #1a1713;
  letter-spacing: 0.08em;
  margin-bottom: 12rpx;
}
.rule-d {
  font-size: 24rpx;
  color: #857b6a;
  line-height: 1.7;
}

/* 底部按钮 */
.onb-foot {
  position: fixed;
  left: 0; right: 0;
  bottom: 80rpx;
  padding: 0 48rpx;
  z-index: 10;
}
.onb-foot .btn-primary {
  width: 100%;
  padding: 32rpx 0;
  box-sizing: border-box;
}

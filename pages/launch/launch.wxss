.launch {
  width: 100vw;
  height: 100vh;
  background: #f5f1e8;
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.launch-bg {
  position: absolute; inset: 0;
  background:
    radial-gradient(ellipse at 50% 40%, rgba(156,58,42,0.04), transparent 60%),
    radial-gradient(ellipse at 85% 85%, rgba(26,23,19,0.05), transparent 60%);
}
.launch-center {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  animation: fade 1.2s both;
}
.taiji {
  width: 200rpx;
  height: 200rpx;
  position: relative;
  margin-bottom: 80rpx;
  animation: spin 40s linear infinite;
}
.taiji-ring {
  position: absolute; inset: 0;
  border: 2rpx solid rgba(26,23,19,0.5);
  border-radius: 50%;
}
.taiji-ring::before {
  content: '';
  position: absolute;
  left: 50%; top: 10%;
  width: 16rpx; height: 16rpx;
  background: #9c3a2a;
  border-radius: 50%;
  transform: translateX(-50%);
}
.taiji-dot {
  position: absolute;
  left: 50%; top: 50%;
  width: 14rpx; height: 14rpx;
  background: #1a1713;
  border-radius: 50%;
  transform: translate(-50%, -50%);
}
@keyframes spin {
  to { transform: rotate(360deg); }
}
.launch-char {
  font-size: 72rpx;
  font-weight: 500;
  letter-spacing: 0.3em;
  color: #1a1713;
  margin-bottom: 20rpx;
}
.launch-en {
  font-family: "Cormorant Garamond", serif;
  font-style: italic;
  font-size: 24rpx;
  letter-spacing: 0.6em;
  color: #9c3a2a;
  margin-bottom: 32rpx;
}
.launch-tag {
  font-size: 24rpx;
  color: #857b6a;
  letter-spacing: 0.15em;
}
.launch-foot {
  position: absolute;
  bottom: 80rpx;
  left: 0; right: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  font-size: 18rpx;
  color: #857b6a;
  letter-spacing: 0.2em;
}
.launch-foot .f-italic {
  font-family: "Cormorant Garamond", serif;
  font-style: italic;
  font-size: 20rpx;
}
.foot-line {
  width: 24rpx; height: 1rpx;
  background: #c9bfa8;
}

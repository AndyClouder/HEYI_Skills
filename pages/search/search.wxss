/* ======== 搜索页 ======== */

.searchbar {
  position: relative;
  margin: 16rpx 0 48rpx;
  padding: 0;
  border-bottom: 1rpx solid rgba(26,23,19,0.3);
}
.sb-input {
  width: 100%;
  padding: 24rpx 80rpx 24rpx 8rpx;
  font-size: 36rpx;
  color: #1a1713;
  font-family: "Noto Serif SC", serif;
  letter-spacing: 0.04em;
  background: transparent;
}
.sb-ph {
  color: #c9bfa8;
  font-size: 32rpx;
  letter-spacing: 0.08em;
}
.sb-clear {
  position: absolute;
  right: 8rpx; top: 50%;
  transform: translateY(-50%);
  width: 56rpx; height: 56rpx;
  display: flex; align-items: center; justify-content: center;
  color: #857b6a;
  font-size: 40rpx;
  line-height: 1;
}

.section {
  margin-bottom: 80rpx;
}
.sec-eyebrow {
  font-size: 22rpx;
  color: #9c3a2a;
  letter-spacing: 0.35em;
  text-transform: uppercase;
  margin-bottom: 12rpx;
}
.sec-eyebrow-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}
.sec-clear {
  font-size: 22rpx;
  color: #857b6a;
  letter-spacing: 0.1em;
}
.sec-title {
  font-size: 36rpx;
  letter-spacing: 0.25em;
  color: #1a1713;
  margin-bottom: 32rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid rgba(26,23,19,0.1);
}

.tag-cloud {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.tag {
  padding: 16rpx 28rpx;
  border: 1rpx solid rgba(26,23,19,0.18);
  font-size: 26rpx;
  color: #3d362c;
  letter-spacing: 0.05em;
  background: rgba(237,231,216,0.5);
}
.tag:active { background: #1a1713; color: #f5f1e8; }
.tag-recent { background: transparent; color: #857b6a; }

/* 结果 */
.res-head {
  padding: 0 0 20rpx;
  margin-bottom: 16rpx;
  border-bottom: 1rpx solid rgba(26,23,19,0.18);
  font-size: 24rpx;
  color: #857b6a;
  letter-spacing: 0.1em;
}
.res-count {
  font-size: 36rpx;
  font-style: italic;
  font-family: "Cormorant Garamond", serif;
  margin-right: 8rpx;
}
.res-list { }
.res-item {
  padding: 32rpx 4rpx;
  border-bottom: 1rpx solid rgba(26,23,19,0.1);
}
.res-item:active { background: rgba(237,231,216,0.5); }
.res-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 14rpx;
}
.res-no {
  font-size: 22rpx;
  color: #c9bfa8;
  letter-spacing: 0.1em;
}
.res-name {
  font-size: 32rpx;
  color: #1a1713;
  letter-spacing: 0.04em;
  line-height: 1.5;
  margin-bottom: 12rpx;
}
.res-desc {
  font-size: 24rpx;
  color: #857b6a;
  line-height: 1.7;
}

/* 空 */
.empty {
  padding: 160rpx 0;
  text-align: center;
}
.empty-ico {
  font-size: 120rpx;
  color: #c9bfa8;
  line-height: 1;
  margin-bottom: 32rpx;
}
.empty-t {
  font-size: 30rpx;
  color: #3d362c;
  letter-spacing: 0.2em;
  margin-bottom: 12rpx;
}
.empty-d {
  font-size: 22rpx;
  color: #857b6a;
  letter-spacing: 0.1em;
}

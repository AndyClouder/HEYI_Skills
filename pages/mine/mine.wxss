/* 合一 Skills - 我的技能页样式 */

/* 上传区域 */
.upload-section {
  padding: 24rpx 0 48rpx;
}

.upload-header {
  margin-bottom: 24rpx;
}

.upload-title {
  display: block;
  font-size: 32rpx;
  font-weight: 500;
  color: #1a1713;
  letter-spacing: 0.1em;
  margin-bottom: 8rpx;
}

.upload-desc {
  display: block;
  font-size: 22rpx;
  color: #857b6a;
}

.upload-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx 32rpx;
  background: #ede7d8;
  border: 2rpx dashed rgba(26, 23, 19, 0.16);
  border-radius: 8rpx;
  transition: all 0.3s;
}

.upload-box:active {
  background: #e0d8c8;
}

.upload-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.upload-text {
  display: block;
  font-size: 28rpx;
  color: #1a1713;
  margin-bottom: 8rpx;
}

.upload-hint {
  display: block;
  font-size: 22rpx;
  color: #857b6a;
}

/* 通用区块 */
.section {
  padding: 24rpx 0;
}

.section-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #1a1713;
  letter-spacing: 0.1em;
}

.section-count {
  font-size: 22rpx;
  color: #857b6a;
}

/* 自定义技能列表 */
.custom-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.custom-item {
  background: #f5f1e8;
  border: 1rpx solid rgba(26, 23, 19, 0.08);
  border-radius: 8rpx;
  overflow: hidden;
}

.custom-main {
  padding: 24rpx;
}

.custom-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.custom-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #1a1713;
}

.custom-tag {
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  font-size: 20rpx;
}

.custom-tag.custom {
  background: rgba(156, 58, 42, 0.1);
  color: #9c3a2a;
}

.custom-desc {
  font-size: 24rpx;
  color: #3d362c;
  line-height: 1.7;
  margin-bottom: 12rpx;
}

.custom-meta {
  display: flex;
  gap: 24rpx;
}

.custom-tech {
  font-size: 20rpx;
  color: #857b6a;
  font-family: monospace;
}

.custom-date {
  font-size: 20rpx;
  color: #c9bfa8;
}

.custom-actions {
  display: flex;
  border-top: 1rpx solid rgba(26, 23, 19, 0.08);
}

.action-btn {
  flex: 1;
  text-align: center;
  padding: 16rpx;
  font-size: 24rpx;
  color: #3d362c;
  border-right: 1rpx solid rgba(26, 23, 19, 0.08);
}

.action-btn:last-child {
  border-right: none;
}

.action-btn.delete {
  color: #9c3a2a;
}

/* 格式说明 */
.format-section {
  margin-top: 48rpx;
  padding: 32rpx;
  background: rgba(26, 23, 19, 0.03);
  border-radius: 8rpx;
}

.format-title {
  font-size: 24rpx;
  color: #857b6a;
  letter-spacing: 0.1em;
  margin-bottom: 16rpx;
}

.format-content {
  background: #1a1713;
  border-radius: 8rpx;
  padding: 24rpx;
}

.format-code {
  display: block;
  font-family: 'JetBrains Mono', monospace;
  font-size: 20rpx;
  color: #c9bfa8;
  line-height: 1.8;
  white-space: pre-wrap;
}

/* 空状态 */
.empty-state {
  padding: 120rpx 0;
  text-align: center;
}

.empty-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
  opacity: 0.4;
}

.empty-text {
  display: block;
  font-size: 28rpx;
  color: #1a1713;
  margin-bottom: 8rpx;
}

.empty-hint {
  display: block;
  font-size: 24rpx;
  color: #857b6a;
}

.scroll { height: 100vh; box-sizing: border-box; }

/* 头 */
.me-head {
  padding: 40rpx 0 48rpx;
  border-bottom: 1rpx solid rgba(26,23,19,0.18);
  margin-bottom: 56rpx;
}
.me-eyebrow {
  font-size: 22rpx;
  color: #9c3a2a;
  letter-spacing: 0.4em;
  text-transform: uppercase;
  margin-bottom: 16rpx;
}
.me-title {
  font-size: 120rpx;
  font-weight: 500;
  letter-spacing: 0.1em;
  color: #1a1713;
  line-height: 1;
  margin-bottom: 20rpx;
}
.me-sub {
  font-size: 26rpx;
  color: #857b6a;
  letter-spacing: 0.25em;
}

/* 段 */
.me-sect {
  margin-bottom: 72rpx;
}
.me-label {
  font-size: 22rpx;
  color: #9c3a2a;
  letter-spacing: 0.4em;
  text-transform: uppercase;
  margin-bottom: 8rpx;
}
.me-label-cn {
  font-size: 32rpx;
  color: #1a1713;
  letter-spacing: 0.25em;
  margin-bottom: 32rpx;
}
.me-label-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 8rpx;
}
.me-add {
  font-size: 22rpx;
  color: #9c3a2a;
  letter-spacing: 0.1em;
  padding: 12rpx 20rpx;
  border: 1rpx solid #9c3a2a;
}
.me-add:active { background: #9c3a2a; color: #f5f1e8; }

/* 进度 */
.gate-progress {
  border-top: 1rpx solid rgba(26,23,19,0.08);
}
.gp {
  padding: 28rpx 4rpx;
  border-bottom: 1rpx solid rgba(26,23,19,0.08);
}
.gp-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}
.gp-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.gp-en {
  font-size: 22rpx;
  color: #857b6a;
  letter-spacing: 0.2em;
}
.gp-num {
  font-size: 20rpx;
  color: #c9bfa8;
  letter-spacing: 0.15em;
}
.gp-bar {
  height: 2rpx;
  background: rgba(26,23,19,0.1);
  position: relative;
}
.gp-bar-fill {
  position: absolute; left: 0; top: 0; bottom: 0;
  background: #9c3a2a;
  transition: width 0.8s ease;
}

/* 自定义列表 */
.custom-list {
  border-top: 1rpx solid rgba(26,23,19,0.08);
}
.cx {
  padding: 32rpx 4rpx;
  border-bottom: 1rpx solid rgba(26,23,19,0.08);
}
.cx-main { }
.cx-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 12rpx;
}
.cx-name {
  font-size: 30rpx;
  color: #1a1713;
  letter-spacing: 0.04em;
  flex: 1;
}
.cx-tag {
  padding: 4rpx 12rpx;
  background: #9c3a2a;
  color: #f5f1e8;
  font-size: 18rpx;
  letter-spacing: 0.15em;
  flex-shrink: 0;
}
.cx-desc {
  font-size: 24rpx;
  color: #857b6a;
  line-height: 1.7;
  margin-bottom: 14rpx;
}
.cx-meta {
  font-size: 20rpx;
  color: #c9bfa8;
  letter-spacing: 0.1em;
  margin-bottom: 16rpx;
}
.cx-ops {
  display: flex;
  gap: 16rpx;
  padding-top: 12rpx;
  border-top: 1rpx dashed rgba(26,23,19,0.1);
}
.op {
  padding: 10rpx 24rpx;
  border: 1rpx solid rgba(26,23,19,0.18);
  font-size: 22rpx;
  color: #3d362c;
  letter-spacing: 0.15em;
}
.op:active { background: #ede7d8; }
.op-del { color: #9c3a2a; border-color: rgba(156,58,42,0.4); }

.custom-empty {
  padding: 80rpx 0 40rpx;
  text-align: center;
  border-top: 1rpx dashed rgba(26,23,19,0.15);
  border-bottom: 1rpx dashed rgba(26,23,19,0.15);
}
.ce-ico {
  font-size: 80rpx;
  color: #c9bfa8;
  line-height: 1;
  margin-bottom: 24rpx;
}
.ce-t {
  font-size: 28rpx;
  color: #1a1713;
  letter-spacing: 0.2em;
  margin-bottom: 12rpx;
}
.ce-d {
  font-size: 22rpx;
  color: #857b6a;
  line-height: 1.7;
  padding: 0 40rpx;
}

/* 日记 */
.diary-sect { }
.diary-box {
  padding: 32rpx 28rpx;
  background: rgba(237,231,216,0.5);
  border: 1rpx solid rgba(26,23,19,0.1);
}
.diary-input {
  width: 100%;
  min-height: 140rpx;
  font-size: 28rpx;
  color: #1a1713;
  line-height: 1.8;
  font-family: "Noto Serif SC", serif;
  letter-spacing: 0.04em;
  background: transparent;
}
.diary-ph { color: #c9bfa8; }
.diary-foot {
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(26,23,19,0.08);
  margin-top: 16rpx;
  font-size: 18rpx;
  color: #c9bfa8;
  letter-spacing: 0.15em;
  text-align: right;
}

/* 底款 */
.me-foot {
  margin-top: 80rpx;
  padding: 40rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  font-size: 22rpx;
  color: #857b6a;
  letter-spacing: 0.15em;
}
.fline {
  width: 32rpx; height: 1rpx;
  background: #c9bfa8;
}

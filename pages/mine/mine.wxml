<!-- 己 · 我的修习 -->
<view class="page">
  <view class="page-bg"></view>

  <scroll-view class="scroll" scroll-y show-scrollbar="{{false}}">
    <view class="container">

      <!-- 头 -->
      <view class="me-head">
        <view class="me-eyebrow f-italic">self</view>
        <view class="me-title">己</view>
        <view class="me-sub">一 人 之 修 习</view>
      </view>

      <!-- 六门修习进度 -->
      <view class="me-sect">
        <view class="me-label f-italic">six gates · progress</view>
        <view class="me-label-cn">六 门 修 习</view>

        <view class="gate-progress">
          <view class="gp" wx:for="{{gateProgress}}" wx:key="id">
            <view class="gp-row">
              <view class="gp-left">
                <view class="gate-chip">{{item.id}}</view>
                <text class="gp-en f-italic">{{item.en}}</text>
              </view>
              <text class="gp-num f-mono">{{item.used}} / {{item.total}}</text>
            </view>
            <view class="gp-bar">
              <view class="gp-bar-fill" style="width: {{item.percent}}%"></view>
            </view>
          </view>
        </view>
      </view>

      <!-- 自定义技能 -->
      <view class="me-sect">
        <view class="me-label-row">
          <view>
            <view class="me-label f-italic">custom skills</view>
            <view class="me-label-cn">自 制 之 技</view>
          </view>
          <view class="me-add" bindtap="onUploadTap">＋ 上传</view>
        </view>

        <view wx:if="{{customSkills.length > 0}}" class="custom-list">
          <view class="cx" wx:for="{{customSkills}}" wx:key="_id">
            <view class="cx-main" bindtap="onViewSkill" data-skill="{{item}}">
              <view class="cx-head">
                <view class="cx-name">{{item.name}}</view>
                <view class="cx-tag">自 制</view>
              </view>
              <view class="cx-desc">{{item.desc}}</view>
              <view class="cx-meta">
                <text class="f-mono">{{item.techName || '—'}}</text>
                <text>· {{item.gate || '未归门'}}</text>
              </view>
            </view>
            <view class="cx-ops">
              <view class="op" bindtap="onEditSkill" data-skill="{{item}}">编</view>
              <view class="op op-del" bindtap="onDeleteSkill" data-skill="{{item}}">删</view>
            </view>
          </view>
        </view>

        <view wx:else class="custom-empty">
          <view class="ce-ico f-italic">×</view>
          <view class="ce-t">经验可成技</view>
          <view class="ce-d">上传 Skills.md，把你的方法论变成可复用的技</view>
        </view>
      </view>

      <!-- 今日一念 -->
      <view class="me-sect diary-sect">
        <view class="me-label f-italic">today's note</view>
        <view class="me-label-cn">今 日 一 念</view>
        <view class="diary-box">
          <textarea class="diary-input"
                    placeholder="记一点，今天用了哪一技，有什么感想"
                    placeholder-class="diary-ph"
                    value="{{diary}}"
                    bindinput="onDiaryInput"
                    bindblur="onDiarySave"
                    maxlength="-1"
                    auto-height></textarea>
          <view class="diary-foot">
            <text class="f-mono">{{diaryDateStr}}</text>
          </view>
        </view>
      </view>

      <!-- 说明 -->
      <view class="me-foot f-italic">
        <text class="fline"></text>
        比你早一步的同路人
        <text class="fline"></text>
      </view>

    </view>
  </scroll-view>
</view>

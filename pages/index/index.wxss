/* ======== 首页 ======== */

/* 顶部 */
.head {
  padding: 20rpx 0 48rpx;
}
.head-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 48rpx;
}
.head-meta {
  text-align: right;
  line-height: 1.6;
}
.head-en {
  font-size: 20rpx;
  color: #857b6a;
  letter-spacing: 0.25em;
}
.head-date {
  font-size: 18rpx;
  color: #c9bfa8;
  letter-spacing: 0.15em;
}
.head-title {
  font-size: 80rpx;
  font-weight: 500;
  letter-spacing: 0.35em;
  color: #1a1713;
  line-height: 1.1;
  margin-bottom: 16rpx;
}
.head-sub {
  font-size: 24rpx;
  color: #857b6a;
  letter-spacing: 0.15em;
}

/* 每日一念 */
.quote {
  position: relative;
  padding: 48rpx 40rpx 40rpx;
  margin-bottom: 56rpx;
  background: rgba(237, 231, 216, 0.5);
  border-top: 1rpx solid rgba(26,23,19,0.1);
  border-bottom: 1rpx solid rgba(26,23,19,0.1);
}
.quote-mark {
  position: absolute;
  top: 8rpx; left: 24rpx;
  font-family: "Cormorant Garamond", serif;
  font-style: italic;
  font-size: 120rpx;
  color: #9c3a2a;
  opacity: 0.45;
  line-height: 1;
}
.quote-text {
  font-size: 32rpx;
  color: #1a1713;
  line-height: 1.9;
  letter-spacing: 0.04em;
  margin-bottom: 20rpx;
  padding-left: 24rpx;
}
.quote-from {
  font-size: 22rpx;
  color: #857b6a;
  letter-spacing: 0.1em;
  padding-left: 24rpx;
}

/* 搜索入口 */
.search-entry {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 26rpx 32rpx;
  background: #ede7d8;
  border: 1rpx solid rgba(26,23,19,0.1);
  margin-bottom: 80rpx;
}
.search-entry:active { background: #e5dcc6; }
.search-ico {
  font-size: 32rpx;
  color: #9c3a2a;
}
.search-ph {
  font-size: 26rpx;
  color: #857b6a;
  letter-spacing: 0.08em;
}

/* 段头 */
.section { margin-bottom: 80rpx; }
.sec-head {
  margin-bottom: 40rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid rgba(26,23,19,0.18);
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}
.sec-label {
  font-size: 22rpx;
  color: #9c3a2a;
  letter-spacing: 0.3em;
  text-transform: lowercase;
}
.sec-title {
  font-size: 36rpx;
  font-weight: 500;
  letter-spacing: 0.25em;
  color: #1a1713;
}

/* 六门 */
.gates-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1rpx;
  background: rgba(26,23,19,0.1);
  border: 1rpx solid rgba(26,23,19,0.1);
}
.gate-cell {
  background: #f5f1e8;
  padding: 40rpx 28rpx 32rpx;
  position: relative;
  transition: background 0.3s;
}
.gate-cell:active { background: #ede7d8; }
.gate-num {
  position: absolute;
  top: 16rpx; right: 20rpx;
  font-size: 22rpx;
  color: #c9bfa8;
  letter-spacing: 0.1em;
}
.gate-char {
  font-size: 64rpx;
  font-weight: 500;
  color: #1a1713;
  line-height: 1;
  margin-bottom: 10rpx;
}
.gate-en {
  font-size: 22rpx;
  color: #9c3a2a;
  letter-spacing: 0.15em;
  margin-bottom: 14rpx;
}
.gate-desc {
  font-size: 22rpx;
  color: #857b6a;
  line-height: 1.7;
  min-height: 74rpx;
  margin-bottom: 14rpx;
}
.gate-count {
  font-size: 18rpx;
  color: #c9bfa8;
  letter-spacing: 0.15em;
}

/* 今日推荐 */
.pick-list {
  border-top: 1rpx solid rgba(26,23,19,0.1);
}
.pick-item {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
  padding: 32rpx 4rpx;
  border-bottom: 1rpx solid rgba(26,23,19,0.1);
}
.pick-item:active { background: rgba(237, 231, 216, 0.5); }
.pick-left {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  width: 64rpx;
  flex-shrink: 0;
}
.pick-no {
  font-size: 28rpx;
  color: #c9bfa8;
  line-height: 1;
}
.pick-body { flex: 1; min-width: 0; }
.pick-name {
  font-size: 30rpx;
  color: #1a1713;
  letter-spacing: 0.04em;
  margin-bottom: 10rpx;
  line-height: 1.5;
}
.pick-desc {
  font-size: 24rpx;
  color: #857b6a;
  line-height: 1.7;
}
.pick-arrow {
  font-size: 28rpx;
  color: #c9bfa8;
  padding-top: 8rpx;
}

/* 近日所行 */
.recent-scroll { width: 100%; }
.recent-row {
  display: inline-flex;
  gap: 20rpx;
  padding: 4rpx 0;
}
.recent-card {
  flex-shrink: 0;
  width: 260rpx;
  padding: 28rpx 24rpx;
  border: 1rpx solid rgba(26,23,19,0.1);
  background: rgba(237, 231, 216, 0.4);
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}
.recent-name {
  font-size: 26rpx;
  color: #1a1713;
  line-height: 1.5;
}

/* 款识 */
.colophon {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  margin-top: 80rpx;
  padding: 40rpx 0;
  font-size: 22rpx;
  color: #857b6a;
  letter-spacing: 0.15em;
}
.cline {
  width: 32rpx;
  height: 1rpx;
  background: #c9bfa8;
}

<!-- 首页 -->
<view class="page">
  <view class="page-bg"></view>

  <view class="container">

    <!-- 顶部品牌 -->
    <view class="head animate-rise">
      <view class="head-row">
        <view class="seal">合</view>
        <view class="head-meta">
          <view class="head-en f-italic">heyi · thirty skills</view>
          <view class="head-date f-mono">{{todayStr}}</view>
        </view>
      </view>
      <view class="head-title">合 一</view>
      <view class="head-sub">非技术人的 AI 技能库 · 三 十 技</view>
    </view>

    <!-- 每日一念 -->
    <view class="quote animate-rise" style="animation-delay:.08s">
      <view class="quote-mark f-italic">"</view>
      <view class="quote-text">{{dailyQuote.text}}</view>
      <view class="quote-from f-italic">— {{dailyQuote.from}}</view>
    </view>

    <!-- 搜索入口 -->
    <view class="search-entry animate-rise" style="animation-delay:.12s" bindtap="onSearchTap">
      <view class="search-ico">⌕</view>
      <view class="search-ph">搜一个技能，如「写公众号」</view>
    </view>

    <!-- 六门 -->
    <view class="section animate-rise" style="animation-delay:.18s">
      <view class="sec-head">
        <view class="sec-label f-italic">six gates</view>
        <view class="sec-title">六 门</view>
      </view>

      <view class="gates-grid">
        <view class="gate-cell" wx:for="{{gates}}" wx:key="id" bindtap="onGateTap" data-gate="{{item.id}}">
          <view class="gate-num f-italic">{{item.roman}}</view>
          <view class="gate-char">{{item.id}}</view>
          <view class="gate-en f-italic">{{item.en}}</view>
          <view class="gate-desc">{{item.shortDesc}}</view>
          <view class="gate-count f-mono">{{item.count}} 技</view>
        </view>
      </view>
    </view>

    <!-- 今日推荐 -->
    <view class="section animate-rise" style="animation-delay:.25s">
      <view class="sec-head">
        <view class="sec-label f-italic">today's pick</view>
        <view class="sec-title">今 日 荐</view>
      </view>

      <view class="pick-list">
        <view class="pick-item" wx:for="{{hotSkills}}" wx:key="code" bindtap="onSkillTap" data-code="{{item.code}}">
          <view class="pick-left">
            <view class="pick-no f-italic">{{item.no}}</view>
            <view class="gate-chip">{{item.gate}}</view>
          </view>
          <view class="pick-body">
            <view class="pick-name">{{item.name}}</view>
            <view class="pick-desc">{{item.desc}}</view>
          </view>
          <view class="pick-arrow f-italic">→</view>
        </view>
      </view>
    </view>

    <!-- 最近 -->
    <view class="section animate-rise" style="animation-delay:.32s" wx:if="{{historySkills.length > 0}}">
      <view class="sec-head">
        <view class="sec-label f-italic">recent</view>
        <view class="sec-title">近 日 所 行</view>
      </view>

      <scroll-view class="recent-scroll" scroll-x show-scrollbar="{{false}}">
        <view class="recent-row">
          <view class="recent-card" wx:for="{{historySkills}}" wx:key="code" bindtap="onSkillTap" data-code="{{item.code}}">
            <view class="gate-chip">{{item.gate}}</view>
            <view class="recent-name">{{item.name}}</view>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- 底部款识 -->
    <view class="colophon f-italic animate-rise" style="animation-delay:.4s">
      <text class="cline"></text>
      <text>heyi lab · 比你早一步的同路人</text>
      <text class="cline"></text>
    </view>

  </view>
</view>

<!-- 合一 Skills - 首页 -->
<view class="page">
  <!-- 宣纸纹理背景 -->
  <view class="page-bg"></view>

  <view class="container">

    <!-- 品牌区 -->
    <view class="hero animate-rise">
      <view class="hero-eyebrow">Heyi Skills · {{totalSkills}}技精选</view>
      <view class="hero-title">合 一 · Skills</view>
      <view class="hero-subtitle">非技术人的 AI 技能库</view>
    </view>

    <!-- 搜索区 -->
    <view class="search-section animate-rise" style="animation-delay: 0.1s">
      <view class="search-box" bindtap="onSearchTap">
        <text class="search-icon">🔍</text>
        <text class="search-placeholder">搜索技能，如"写公众号"</text>
      </view>

      <!-- 搜索建议 Chip -->
      <scroll-view class="suggestions-scroll" scroll-x show-scrollbar="{{false}}">
        <view class="suggestions">
          <view class="chip" wx:for="{{searchSuggestions}}" wx:key="index" bindtap="onSuggestionTap" data-keyword="{{item}}">
            {{item}}
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- 六门概览 -->
    <view class="gates-section animate-rise" style="animation-delay: 0.2s">
      <view class="section-header">
        <text class="section-title">六 门</text>
        <text class="section-subtitle">按你需要做的事找技能</text>
      </view>

      <view class="gates-grid">
        <view class="gate-item" wx:for="{{gates}}" wx:key="id" bindtap="onGateTap" data-gate="{{item.id}}">
          <view class="gate-char">{{item.id}}</view>
          <view class="gate-en">{{item.en}}</view>
          <view class="gate-count">{{item.count}}技</view>
        </view>
      </view>
    </view>

    <!-- 热门技能 -->
    <view class="hot-section animate-rise" style="animation-delay: 0.3s">
      <view class="section-header">
        <text class="section-title">热 门</text>
        <text class="section-subtitle">大家都在用</text>
      </view>

      <view class="hot-list">
        <view class="hot-item" wx:for="{{hotSkills}}" wx:key="code" bindtap="onSkillTap" data-code="{{item.code}}">
          <view class="hot-rank">{{item.rank}}</view>
          <view class="hot-info">
            <view class="hot-name">{{item.name}}</view>
            <view class="hot-desc">{{item.desc}}</view>
          </view>
          <view class="hot-arrow">→</view>
        </view>
      </view>
    </view>

    <!-- 历史记录 -->
    <view class="history-section animate-rise" style="animation-delay: 0.4s" wx:if="{{history.length > 0}}">
      <view class="section-header">
        <text class="section-title">已 陪 你</text>
        <text class="section-subtitle">{{history.length}} 次</text>
      </view>

      <scroll-view class="history-scroll" scroll-x show-scrollbar="{{false}}">
        <view class="history-list">
          <view class="history-item" wx:for="{{historySkills}}" wx:key="code" bindtap="onSkillTap" data-code="{{item.code}}">
            <view class="history-char">{{item.gate}}</view>
            <view class="history-name">{{item.name}}</view>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- 统计信息 -->
    <view class="stats-section animate-rise" style="animation-delay: 0.5s">
      <view class="stats-text">
        <text class="stats-num">{{totalSkills}}</text>
        <text class="stats-label">个技能</text>
        <text class="stats-divider"> · </text>
        <text class="stats-num">6</text>
        <text class="stats-label">门分类</text>
      </view>
      <view class="stats-source">
        <text class="source-item heyi">● SkillHub 精选</text>
        <text class="source-item">{{totalSkills}} 个真实可用技能</text>
        <text class="source-item" wx:if="{{customSkillsCount > 0}}"> · 含 {{customSkillsCount}} 个自定义</text>
      </view>
    </view>

  </view>
</view>

<!-- 详情页 -->
<view class="page">
  <view class="page-bg"></view>

  <scroll-view class="scroll" scroll-y show-scrollbar="{{false}}">
    <view class="container">

      <!-- 头部门牌 -->
      <view class="d-head">
        <view class="d-meta">
          <text class="d-no f-italic">{{skill.no}} / 30</text>
          <view class="gate-chip d-gate">{{skill.gate}}</view>
        </view>
        <view class="d-name">{{skill.name}}</view>
        <view class="d-desc">{{skill.desc}}</view>
        <view class="d-code f-mono">{{skill.techName}}</view>
      </view>

      <!-- 展开说明 -->
      <view class="d-sect" wx:if="{{skill.fullDesc}}">
        <view class="d-label f-italic">what it is</view>
        <view class="d-label-cn">这是什么</view>
        <view class="d-text">{{skill.fullDesc}}</view>
      </view>

      <!-- 看看效果 -->
      <view class="d-sect" wx:if="{{skill.examples && skill.examples.length > 0}}">
        <view class="d-label f-italic">in action</view>
        <view class="d-label-cn">看一看效果</view>
        <view class="ex-list">
          <view class="ex" wx:for="{{skill.examples}}" wx:key="index">
            <view class="ex-row">
              <view class="ex-k">你 说</view>
              <view class="ex-v">{{item.input}}</view>
            </view>
            <view class="ex-sep">
              <view class="ex-sep-line"></view>
              <text class="ex-sep-ico">↓</text>
              <view class="ex-sep-line"></view>
            </view>
            <view class="ex-row ex-row-ai">
              <view class="ex-k t-cinnabar">AI 回</view>
              <view class="ex-v">{{item.output}}</view>
            </view>
          </view>
        </view>
      </view>

      <!-- 怎么用 -->
      <view class="d-sect" wx:if="{{skill.steps && skill.steps.length > 0}}">
        <view class="d-label f-italic">how to use</view>
        <view class="d-label-cn">怎 么 用</view>
        <view class="step-list">
          <view class="step" wx:for="{{skill.steps}}" wx:for-index="i" wx:key="*">
            <view class="step-n f-italic">{{i + 1}}</view>
            <view class="step-t">{{item}}</view>
          </view>
        </view>
      </view>

      <!-- 心法 -->
      <view class="d-sect d-sect-dharma" wx:if="{{skill.dharma}}" bindtap="toggleDharma">
        <view class="dharma-head">
          <view>
            <view class="d-label f-italic">the way</view>
            <view class="d-label-cn">背 后 的 心 法</view>
          </view>
          <view class="dharma-toggle f-italic">{{dharmaExpanded ? '收' : '展'}}</view>
        </view>
        <view class="dharma-body {{dharmaExpanded ? 'open' : ''}}">
          <view class="dharma-text">{{skill.dharma}}</view>
        </view>
      </view>

      <!-- 评分 -->
      <view class="d-rating" wx:if="{{skill.rating}}">
        <view class="rating-label f-italic">rating</view>
        <view class="rating-stars t-cinnabar">
          <text wx:for="{{skill.rating}}" wx:for-item="s" wx:key="*">★</text>
          <text wx:for="{{5 - skill.rating}}" wx:for-item="s" wx:key="*" class="t-faint">★</text>
        </view>
        <view class="rating-install f-mono" wx:if="{{skill.installs}}">{{skill.installs}} 安装</view>
      </view>

      <view class="d-bottom-space"></view>
    </view>
  </scroll-view>

  <!-- 底部操作 -->
  <view class="d-actions">
    <view class="act-fav {{isFavorited ? 'on' : ''}}" bindtap="toggleFavorite">
      <text class="act-fav-ico">{{isFavorited ? '●' : '○'}}</text>
      <text class="act-fav-t">{{isFavorited ? '已藏' : '藏'}}</text>
    </view>
    <view class="act-try" bindtap="onTryTap">试 一 试 →</view>
  </view>
</view>

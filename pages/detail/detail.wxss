/* 合一 Skills - 详情页样式 */

.scroll-container {
  height: 100vh;
}

/* 头部 */
.detail-header {
  padding: 40rpx 0;
}

.header-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.gate-badge-large {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ede7d8;
  border: 1rpx solid rgba(26, 23, 19, 0.16);
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #3d362c;
  font-weight: 500;
}

.skill-code {
  font-size: 22rpx;
  color: #857b6a;
  font-family: monospace;
  letter-spacing: 0.05em;
}

.skill-num {
  font-size: 64rpx;
  font-family: serif;
  font-style: italic;
  color: #c9bfa8;
  font-weight: 300;
  line-height: 1;
  margin-bottom: 16rpx;
}

.skill-name {
  font-size: 44rpx;
  font-weight: 500;
  color: #1a1713;
  line-height: 1.3;
  margin-bottom: 16rpx;
  letter-spacing: 0.05em;
}

.skill-desc {
  font-size: 26rpx;
  color: #3d362c;
  line-height: 1.8;
}

/* 来源标签行 */
.source-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-top: 24rpx;
}

.source-tag {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 16rpx;
  background: rgba(156, 58, 42, 0.1);
  border-radius: 100rpx;
  font-size: 22rpx;
  color: #9c3a2a;
}

.source-dot {
  width: 8rpx;
  height: 8rpx;
  background: currentColor;
  border-radius: 50%;
}

.source-dot {
  width: 8rpx;
  height: 8rpx;
  background: currentColor;
  border-radius: 50%;
}

.skill-rating {
  font-size: 24rpx;
  color: #c9bfa8;
}

/* 通用区块 */
.section {
  padding: 32rpx 0;
  border-top: 1rpx solid rgba(26, 23, 19, 0.08);
}

.section-label {
  font-size: 24rpx;
  color: #857b6a;
  letter-spacing: 0.15em;
  margin-bottom: 16rpx;
}

.section-content {
  font-size: 28rpx;
  color: #1a1713;
  line-height: 1.8;
}

/* 一句话展开 */
.human-speak {
  background: rgba(156, 58, 42, 0.05);
  border-radius: 8rpx;
  padding: 24rpx;
  border: none;
}

/* 例子 */
.example-list {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.example-item {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.example-before,
.example-after {
  padding: 20rpx;
  border-radius: 8rpx;
}

.example-before {
  background: #ede7d8;
}

.example-after {
  background: rgba(26, 23, 19, 0.03);
  border: 1rpx solid rgba(26, 23, 19, 0.08);
}

.example-label {
  font-size: 20rpx;
  color: #857b6a;
  margin-bottom: 8rpx;
}

.example-content {
  font-size: 26rpx;
  color: #1a1713;
  line-height: 1.7;
  white-space: pre-wrap;
}

.example-arrow {
  text-align: center;
  font-size: 32rpx;
  color: #c9bfa8;
  line-height: 1;
}

/* 步骤 */
.steps-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.step-item {
  display: flex;
  gap: 20rpx;
}

.step-num {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #1a1713;
  color: #f5f1e8;
  border-radius: 50%;
  font-size: 22rpx;
  flex-shrink: 0;
}

.step-content {
  flex: 1;
  font-size: 28rpx;
  color: #1a1713;
  line-height: 1.8;
  padding-top: 6rpx;
}

/* 安装说明 */
.install-section {
  background: rgba(26, 23, 19, 0.03);
  border-radius: 8rpx;
  padding: 24rpx;
  border: none;
}

.install-content {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.install-step {
  font-size: 26rpx;
  color: #1a1713;
  line-height: 1.7;
}

.install-step .highlight {
  color: #9c3a2a;
  font-weight: 500;
}

.install-step .code {
  background: #ede7d8;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  font-family: monospace;
  font-size: 22rpx;
  color: #1a1713;
}

.install-note {
  margin-top: 12rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(26, 23, 19, 0.08);
  font-size: 22rpx;
  color: #857b6a;
  text-align: center;
}

/* 心法 */
.dharma-section {
  border-top: 1rpx solid rgba(156, 58, 42, 0.2);
}

.dharma-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.dharma-label {
  font-size: 24rpx;
  color: #9c3a2a;
  letter-spacing: 0.15em;
}

.dharma-toggle {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: #857b6a;
  transition: all 0.3s;
}

.dharma-toggle.expanded {
  color: #9c3a2a;
}

.dharma-content {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.4s ease;
}

.dharma-content.show {
  max-height: 500rpx;
}

.dharma-text {
  padding-top: 16rpx;
  font-size: 26rpx;
  color: #3d362c;
  line-height: 1.8;
  white-space: pre-line;
}

/* 底部留空 */
.bottom-spacer {
  height: 32rpx;
}

/* 操作按钮 */
.action-buttons {
  display: flex;
  gap: 16rpx;
  margin-top: 32rpx;
}

.action-btn {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8rpx;
  font-size: 28rpx;
  letter-spacing: 0.1em;
}

.action-btn.favorite {
  background: transparent;
  border: 1rpx solid rgba(26, 23, 19, 0.16);
  color: #3d362c;
  flex-direction: column;
  gap: 4rpx;
}

.action-btn.favorite.favorited {
  background: rgba(156, 58, 42, 0.1);
  border-color: rgba(156, 58, 42, 0.3);
  color: #9c3a2a;
}

.action-btn.favorite .btn-icon {
  font-size: 32rpx;
}

.action-btn.favorite .btn-text {
  font-size: 20rpx;
}

.action-btn.primary {
  background: #9c3a2a;
  color: #f5f1e8;
}

.action-btn:active {
  opacity: 0.8;
}

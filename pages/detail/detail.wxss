/* ======== 详情页 ======== */

.scroll {
  height: 100vh;
  box-sizing: border-box;
}

/* 头部 */
.d-head {
  padding: 40rpx 0 56rpx;
  border-bottom: 1rpx solid rgba(26,23,19,0.18);
  margin-bottom: 56rpx;
}
.d-meta {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 32rpx;
}
.d-no {
  font-size: 24rpx;
  color: #9c3a2a;
  letter-spacing: 0.2em;
}
.d-gate {
  width: 44rpx; height: 44rpx;
  font-size: 26rpx;
}
.d-name {
  font-size: 56rpx;
  font-weight: 500;
  color: #1a1713;
  line-height: 1.35;
  letter-spacing: 0.04em;
  margin-bottom: 24rpx;
}
.d-desc {
  font-size: 28rpx;
  color: #3d362c;
  line-height: 1.85;
  letter-spacing: 0.02em;
  margin-bottom: 24rpx;
}
.d-code {
  font-size: 20rpx;
  color: #857b6a;
  letter-spacing: 0.15em;
}

/* 段落 */
.d-sect {
  padding: 16rpx 0 48rpx;
  margin-bottom: 16rpx;
  border-bottom: 1rpx solid rgba(26,23,19,0.08);
}
.d-label {
  font-size: 22rpx;
  color: #9c3a2a;
  letter-spacing: 0.4em;
  text-transform: uppercase;
  margin-bottom: 8rpx;
}
.d-label-cn {
  font-size: 32rpx;
  color: #1a1713;
  letter-spacing: 0.2em;
  margin-bottom: 32rpx;
}
.d-text {
  font-size: 28rpx;
  color: #3d362c;
  line-height: 1.9;
  letter-spacing: 0.02em;
}

/* 例子 */
.ex-list { }
.ex {
  padding: 36rpx 32rpx;
  background: rgba(237,231,216,0.5);
  border-left: 2rpx solid #9c3a2a;
  margin-bottom: 24rpx;
}
.ex-row { }
.ex-k {
  font-size: 22rpx;
  color: #857b6a;
  letter-spacing: 0.2em;
  margin-bottom: 12rpx;
}
.ex-v {
  font-size: 26rpx;
  color: #1a1713;
  line-height: 1.8;
  letter-spacing: 0.02em;
}
.ex-sep {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 24rpx 0;
}
.ex-sep-line {
  flex: 1;
  height: 1rpx;
  background: rgba(26,23,19,0.18);
}
.ex-sep-ico {
  color: #9c3a2a;
  font-size: 24rpx;
}

/* 步骤 */
.step-list {
  border-top: 1rpx solid rgba(26,23,19,0.08);
}
.step {
  display: flex;
  gap: 28rpx;
  padding: 32rpx 4rpx;
  border-bottom: 1rpx solid rgba(26,23,19,0.08);
  align-items: flex-start;
}
.step-n {
  font-size: 40rpx;
  color: #c9bfa8;
  line-height: 1;
  width: 56rpx;
  flex-shrink: 0;
}
.step-t {
  font-size: 28rpx;
  color: #1a1713;
  line-height: 1.7;
  flex: 1;
}

/* 心法 */
.d-sect-dharma {
  padding: 40rpx 32rpx 16rpx;
  background: #1a1713;
  color: #f5f1e8;
  border: none;
  margin: 16rpx 0 56rpx;
}
.d-sect-dharma .d-label { color: #9c3a2a; }
.d-sect-dharma .d-label-cn { color: #f5f1e8; }
.dharma-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}
.dharma-toggle {
  font-size: 22rpx;
  color: #c9bfa8;
  letter-spacing: 0.2em;
  padding: 8rpx 16rpx;
  border: 1rpx solid rgba(245,241,232,0.3);
}
.dharma-body {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.5s cubic-bezier(.2,.8,.2,1);
}
.dharma-body.open {
  max-height: 600rpx;
  padding-top: 24rpx;
}
.dharma-text {
  font-size: 30rpx;
  color: #f5f1e8;
  line-height: 2;
  letter-spacing: 0.08em;
  font-family: "Noto Serif SC", serif;
  white-space: pre-wrap;
  padding: 24rpx 0 16rpx;
  border-top: 1rpx solid rgba(245,241,232,0.18);
}

/* 评分 */
.d-rating {
  display: flex;
  align-items: baseline;
  gap: 20rpx;
  padding: 24rpx 0;
  margin-bottom: 56rpx;
}
.rating-label {
  font-size: 20rpx;
  color: #9c3a2a;
  letter-spacing: 0.3em;
  text-transform: uppercase;
}
.rating-stars {
  font-size: 26rpx;
  letter-spacing: 0.1em;
}
.rating-install {
  font-size: 18rpx;
  color: #c9bfa8;
  letter-spacing: 0.15em;
  margin-left: auto;
}
.t-faint { color: #c9bfa8 !important; }

.d-bottom-space { height: 180rpx; }

/* 底部按钮 */
.d-actions {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  display: flex;
  background: #f5f1e8;
  border-top: 1rpx solid rgba(26,23,19,0.18);
  z-index: 10;
  padding-bottom: env(safe-area-inset-bottom);
}
.act-fav {
  flex: 0 0 180rpx;
  padding: 36rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: #857b6a;
  letter-spacing: 0.2em;
  border-right: 1rpx solid rgba(26,23,19,0.1);
}
.act-fav.on { color: #9c3a2a; }
.act-fav-ico { font-size: 32rpx; line-height: 1; }
.act-try {
  flex: 1;
  background: #1a1713;
  color: #f5f1e8;
  padding: 40rpx 0;
  text-align: center;
  font-size: 30rpx;
  letter-spacing: 0.3em;
}
.act-try:active { opacity: 0.8; }

/* 合一 Skills - 收藏页样式 */

.section {
  padding: 24rpx 0;
}

.section-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #1a1713;
  letter-spacing: 0.15em;
}

.section-count {
  font-size: 22rpx;
  color: #857b6a;
}

/* 技能列表 */
.skill-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.skill-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  background: #f5f1e8;
  border: 1rpx solid rgba(26, 23, 19, 0.08);
  border-radius: 8rpx;
  transition: background 0.3s;
}

.skill-item:active {
  background: #ede7d8;
}

.skill-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
  min-width: 0;
}

.gate-tag {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ede7d8;
  border: 1rpx solid rgba(26, 23, 19, 0.16);
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #3d362c;
  flex-shrink: 0;
}

.skill-info {
  flex: 1;
  min-width: 0;
}

.skill-name {
  font-size: 28rpx;
  color: #1a1713;
  margin-bottom: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.skill-desc {
  font-size: 22rpx;
  color: #857b6a;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.skill-arrow {
  font-size: 32rpx;
  color: #c9bfa8;
  flex-shrink: 0;
}

/* 历史区域 */
.history-section {
  padding: 0;
}

.divider {
  height: 1rpx;
  background: rgba(26, 23, 19, 0.08);
  margin: 32rpx 0;
}

/* 历史列表 */
.history-list {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.history-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  background: rgba(26, 23, 19, 0.02);
  border-radius: 8rpx;
}

.history-gate {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ede7d8;
  border-radius: 4rpx;
  font-size: 20rpx;
  color: #3d362c;
  flex-shrink: 0;
}

.history-name {
  flex: 1;
  font-size: 26rpx;
  color: #1a1713;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.history-time {
  font-size: 20rpx;
  color: #c9bfa8;
  flex-shrink: 0;
}

/* 空状态 */
.empty-state {
  padding: 120rpx 0;
  text-align: center;
}

.empty-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
  opacity: 0.4;
}

.empty-text {
  display: block;
  font-size: 28rpx;
  color: #1a1713;
  margin-bottom: 8rpx;
}

.empty-hint {
  display: block;
  font-size: 24rpx;
  color: #857b6a;
}

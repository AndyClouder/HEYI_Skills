.scroll { height: 100vh; box-sizing: border-box; }

.fav-head {
  padding: 40rpx 0 48rpx;
  margin-bottom: 40rpx;
  border-bottom: 1rpx solid rgba(26,23,19,0.18);
  position: relative;
}
.fav-eyebrow {
  font-size: 22rpx;
  color: #9c3a2a;
  letter-spacing: 0.4em;
  text-transform: uppercase;
  margin-bottom: 16rpx;
}
.fav-title {
  font-size: 120rpx;
  font-weight: 500;
  letter-spacing: 0.1em;
  color: #1a1713;
  line-height: 1;
  margin-bottom: 20rpx;
}
.fav-sub {
  font-size: 26rpx;
  color: #857b6a;
  letter-spacing: 0.25em;
}
.fav-count {
  position: absolute;
  top: 40rpx; right: 0;
  font-size: 20rpx;
  color: #c9bfa8;
  letter-spacing: 0.2em;
}

/* 列表 */
.fav-list {
  border-top: 1rpx solid rgba(26,23,19,0.08);
}
.fv {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
  padding: 36rpx 4rpx;
  border-bottom: 1rpx solid rgba(26,23,19,0.08);
}
.fv:active { background: rgba(237,231,216,0.5); }
.fv-meta {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
  width: 56rpx;
}
.fv-no {
  font-size: 22rpx;
  color: #c9bfa8;
}
.fv-body { flex: 1; min-width: 0; }
.fv-name {
  font-size: 30rpx;
  color: #1a1713;
  letter-spacing: 0.04em;
  margin-bottom: 10rpx;
  line-height: 1.5;
}
.fv-desc {
  font-size: 24rpx;
  color: #857b6a;
  line-height: 1.7;
}
.fv-arrow {
  font-size: 28rpx;
  color: #c9bfa8;
  padding-top: 8rpx;
}

/* 空 */
.empty {
  padding: 120rpx 0 80rpx;
  text-align: center;
}
.empty-ico {
  font-size: 120rpx;
  color: #c9bfa8;
  line-height: 1;
  margin-bottom: 40rpx;
}
.empty-t {
  font-size: 32rpx;
  color: #1a1713;
  letter-spacing: 0.25em;
  margin-bottom: 16rpx;
}
.empty-d {
  font-size: 24rpx;
  color: #857b6a;
  letter-spacing: 0.1em;
  margin-bottom: 48rpx;
}
.empty-btn {
  display: inline-block;
  padding: 24rpx 56rpx;
}

/* 历史段 */
.fav-section { padding-top: 16rpx; }
.sec-line {
  width: 60rpx;
  height: 2rpx;
  background: #9c3a2a;
  margin: 80rpx auto 48rpx;
}
.sec-eyebrow {
  font-size: 22rpx;
  color: #9c3a2a;
  letter-spacing: 0.4em;
  text-transform: uppercase;
  margin-bottom: 12rpx;
}
.sec-title-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 32rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid rgba(26,23,19,0.18);
}
.sec-title {
  font-size: 36rpx;
  letter-spacing: 0.25em;
  color: #1a1713;
}
.sec-clear {
  font-size: 22rpx;
  color: #857b6a;
  letter-spacing: 0.1em;
  padding: 8rpx 16rpx;
}

.hist-list { }
.hi {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx 4rpx;
  border-bottom: 1rpx solid rgba(26,23,19,0.08);
}
.hi:active { background: rgba(237,231,216,0.5); }
.hi-body { flex: 1; min-width: 0; }
.hi-name {
  font-size: 26rpx;
  color: #1a1713;
  letter-spacing: 0.04em;
  line-height: 1.5;
  margin-bottom: 6rpx;
}
.hi-time {
  font-size: 18rpx;
  color: #c9bfa8;
  letter-spacing: 0.15em;
}

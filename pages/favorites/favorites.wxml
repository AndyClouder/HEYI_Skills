<!-- 藏 · 收藏 -->
<view class="page">
  <view class="page-bg"></view>

  <scroll-view class="scroll" scroll-y show-scrollbar="{{false}}">
    <view class="container">

      <!-- 头 -->
      <view class="fav-head">
        <view class="fav-eyebrow f-italic">collected</view>
        <view class="fav-title">藏</view>
        <view class="fav-sub">所 愿 亲 近 之 技</view>
        <view class="fav-count f-mono">{{favorites.length}} / {{total}}</view>
      </view>

      <!-- 收藏列表 -->
      <view wx:if="{{favorites.length > 0}}">
        <view class="fav-list">
          <view class="fv" wx:for="{{favorites}}" wx:key="code"
                bindtap="onSkillTap" data-code="{{item.code}}">
            <view class="fv-meta">
              <view class="gate-chip">{{item.gate}}</view>
              <text class="fv-no f-italic">{{item.no}}</text>
            </view>
            <view class="fv-body">
              <view class="fv-name">{{item.name}}</view>
              <view class="fv-desc">{{item.desc}}</view>
            </view>
            <view class="fv-arrow f-italic">→</view>
          </view>
        </view>
      </view>

      <!-- 空 -->
      <view class="empty" wx:if="{{favorites.length === 0}}">
        <view class="empty-ico f-italic">○</view>
        <view class="empty-t">尚 无 所 藏</view>
        <view class="empty-d">遇见顺手的技，轻点「藏」即可</view>
        <view class="btn-outline empty-btn" bindtap="goHome">去 合 一 首 页</view>
      </view>

      <!-- 最近使用 -->
      <view class="fav-section" wx:if="{{history.length > 0}}">
        <view class="sec-line"></view>
        <view class="sec-eyebrow f-italic">recent</view>
        <view class="sec-title-row">
          <view class="sec-title">近 日 所 行</view>
          <view class="sec-clear" bindtap="onClearHistory">清空</view>
        </view>

        <view class="hist-list">
          <view class="hi" wx:for="{{history}}" wx:key="code"
                bindtap="onSkillTap" data-code="{{item.code}}">
            <view class="gate-chip">{{item.gate}}</view>
            <view class="hi-body">
              <view class="hi-name">{{item.name}}</view>
              <view class="hi-time f-mono">{{item.time}}</view>
            </view>
          </view>
        </view>
      </view>

    </view>
  </scroll-view>
</view>
